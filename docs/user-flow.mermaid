%% AgenticOcean — User Fund Flow
%% Deposit → Smart Vault → AI Agent → Rebalancing across 4 Protocols

flowchart TD
    %% ─── USER ENTRY ───
    USER["👤 User<br/>(Freighter Wallet)"]
    USER -->|"1. Connect wallet<br/>+ sign tx"| DEPOSIT["Deposit USDC<br/>into Smart Vault"]

    %% ─── ON-CHAIN VAULT ───
    DEPOSIT -->|"token.transfer(user → vault)"| VAULT["🔐 UserVault Contract<br/>(Soroban C-account)<br/>Holds USDC on-chain"]

    VAULT -->|"2. Owner adds AI agent<br/>with daily spend limit"| AGENT_AUTH["Agent Authorized<br/>daily_limit: 10 USDC<br/>destinations: whitelisted"]

    %% ─── AI AGENT ACTIVATION ───
    AGENT_AUTH -->|"3. Agent queries<br/>yield data"| AI["🤖 AI Yield Optimizer<br/>(Claude API)<br/>Analyzes APYs + risk"]

    %% ─── DATA FEEDS ───
    AI -->|"Fetch live rates"| DATA_BLEND["Blend SDK<br/>Supply APY: 7.2%<br/>Utilization: 67%"]
    AI -->|"Fetch swap rates"| DATA_SORO["Soroswap SDK<br/>LP APY: 12.5%<br/>Price impact"]
    AI -->|"Fetch vault yields"| DATA_DEFI["DeFindex API<br/>Auto-compound: 9.1%<br/>Multi-strategy: 11.3%"]
    AI -->|"Fetch RWA rates"| DATA_ONDO["Ondo USDY<br/>Treasury yield: 4.8%<br/>Lowest risk"]

    %% ─── STRATEGY GENERATION ───
    DATA_BLEND --> STRATEGY
    DATA_SORO --> STRATEGY
    DATA_DEFI --> STRATEGY
    DATA_ONDO --> STRATEGY
    AI -->|"4. Generate<br/>allocation strategy"| STRATEGY["📊 Allocation Strategy<br/>Sum = 100%"]

    %% ─── REBALANCER EXECUTION ───
    STRATEGY -->|"5. Set targets<br/>for rebalancer"| REBALANCER["⚙️ Rebalancer Engine<br/>(runs every 5 min)<br/>Drift threshold: 5%"]

    REBALANCER -->|"Check drift<br/>current vs target"| DRIFT{{"Drift > 5%?"}}

    DRIFT -->|No| WAIT["⏳ Wait for<br/>next cycle"]
    WAIT --> REBALANCER

    DRIFT -->|Yes| EXECUTE["Execute Rebalance"]

    %% ─── PROTOCOL ALLOCATIONS ───
    EXECUTE -->|"Supply USDC<br/>~30% allocation"| BLEND["🏦 Blend Protocol<br/>(Lending)<br/>APY: 7.2%<br/>+ BLND rewards"]

    EXECUTE -->|"Provide LP<br/>~25% allocation"| SOROSWAP["🔄 Soroswap<br/>(AMM DEX)<br/>APY: 12.5%<br/>USDC/XLM pair"]

    EXECUTE -->|"Deposit to vault<br/>~30% allocation"| DEFINDEX["📦 DeFindex<br/>(Vault Aggregator)<br/>APY: 9.1–11.3%<br/>Auto-compound"]

    EXECUTE -->|"Hold RWA<br/>~15% allocation"| ONDO["🏛️ Ondo USDY<br/>(Real World Assets)<br/>APY: 4.8%<br/>Treasury-backed"]

    %% ─── YIELDS FLOW BACK ───
    BLEND -->|"Interest +<br/>BLND emissions"| RETURNS["💰 Yield Returns"]
    SOROSWAP -->|"Trading fees +<br/>LP rewards"| RETURNS
    DEFINDEX -->|"Compounded<br/>vault yields"| RETURNS
    ONDO -->|"Treasury<br/>interest"| RETURNS

    RETURNS -->|"Accumulate in vault"| VAULT

    %% ─── STYLING ───
    classDef user fill:#6366f1,stroke:#4f46e5,color:#fff,font-weight:bold
    classDef vault fill:#1e1b4b,stroke:#6366f1,color:#e0e7ff,font-weight:bold
    classDef ai fill:#7c3aed,stroke:#6d28d9,color:#fff,font-weight:bold
    classDef protocol fill:#0f172a,stroke:#38bdf8,color:#e0f2fe
    classDef data fill:#1e293b,stroke:#64748b,color:#cbd5e1
    classDef action fill:#065f46,stroke:#10b981,color:#d1fae5
    classDef returns fill:#854d0e,stroke:#f59e0b,color:#fef3c7,font-weight:bold

    class USER user
    class VAULT,AGENT_AUTH vault
    class AI,STRATEGY ai
    class BLEND,SOROSWAP,DEFINDEX,ONDO protocol
    class DATA_BLEND,DATA_SORO,DATA_DEFI,DATA_ONDO data
    class DEPOSIT,EXECUTE,REBALANCER action
    class RETURNS returns
